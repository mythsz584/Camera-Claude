<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <!-- Tela da camera -->
    <LinearLayout
        android:id="@+id/cameraLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra de cima -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp"
            android:paddingStart="8dp">

            <ImageButton
                android:id="@+id/btnFlash"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/flash"
                android:src="@drawable/ic_flash_off" />

            <ImageButton
                android:id="@+id/btnAi"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_toggle"
                android:src="@drawable/ic_ai" />

            <ImageButton
                android:id="@+id/btnQuality"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quality"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <!-- Imagem da camera e controles por cima -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.fotoia.app.GridOverlay
                android:id="@+id/gridOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/recText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:background="#CCE53935"
                android:paddingBottom="4dp"
                android:paddingEnd="12dp"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/countdownText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:shadowColor="#FF000000"
                android:shadowRadius="12"
                android:textColor="@android:color/white"
                android:textSize="96sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/zoomText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginEnd="52dp"
                android:layout_marginTop="16dp"
                android:background="#80000000"
                android:paddingBottom="2dp"
                android:paddingEnd="8dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:textColor="#FFFFC107"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Barra de zoom -->
            <com.fotoia.app.ZoomBar
                android:id="@+id/zoomBar"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginBottom="232dp"
                android:layout_marginTop="8dp" />

            <!-- Noite e mais opcoes -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="112dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnNight"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/circle_dark"
                    android:contentDescription="@string/night"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_moon" />

                <ImageButton
                    android:id="@+id/btnMore"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_dark"
                    android:contentDescription="@string/more_options"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dots" />
            </LinearLayout>

            <!-- Zoom -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="112dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnZoomA"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/circle_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="1x"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnZoomB"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="2x"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Galeria, disparo e virar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/btnGallery"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_gray"
                        android:clickable="true"
                        android:contentDescription="@string/gallery"
                        android:focusable="true"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <View
                    android:id="@+id/btnShutter"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/shutter"
                    android:clickable="true"
                    android:contentDescription="@string/shutter"
                    android:focusable="true" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/btnFlip"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_dark"
                        android:contentDescription="@string/flip"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_flip" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Modos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabPortrait"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:text="@string/mode_portrait"
                android:textAllCaps="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabPhoto"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:text="@string/mode_photo"
                android:textAllCaps="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabVideo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:text="@string/mode_video"
                android:textAllCaps="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabMore"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:text="@string/mode_more"
                android:textAllCaps="true"
                android:textColor="#FF9E9E9E"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tela do resultado -->
    <FrameLayout
        android:id="@+id/resultLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/photo_desc"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/scrim"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/scrim"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="24dp"
            android:paddingTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiscard"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="@string/discard" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/save" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
